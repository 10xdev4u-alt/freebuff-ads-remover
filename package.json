{
  "name": "freebuff-ads-remover",
  "version": "1.2.0",
  "description": "Pluggable extension to remove ads from Freebuff Desktop",
  "homepage": "https://10xdev4u-alt.github.io/freebuff-ads-remover/",
  "bugs": {
    "url": "https://github.com/10xdev4u-alt/freebuff-ads-remover/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config",
    "scripts"
  ],
  "scripts": {
    "build": "tsc && node scripts/finalize-dist.mjs",
    "patch-app": "node scripts/patch-freebuff-app.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eslint.json",
    "prepare": "husky"
  },
  "keywords": [
    "freebuff",
    "electron",
    "extension",
    "ad-blocker",
    "adblock",
    "privacy",
    "ads"
  ],
  "author": "10xdev4u-alt <10xdev4u@gmail.com>",
  "contributors": [
    "the-ai-developer <88466089+the-ai-developer@users.noreply.github.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/10xdev4u-alt/freebuff-ads-remover.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@electron/asar": "^4.3.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.0"
  }
}
